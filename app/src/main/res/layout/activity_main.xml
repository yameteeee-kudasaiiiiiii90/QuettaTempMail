<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- iOS Frosted Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#120E16"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_status_pill"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">
                <View
                    android:id="@+id/statusDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_green_dot"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Watching Live"
                    android:textColor="#30D158"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_icon_btn"
                android:src="@drawable/ic_refresh"
                android:tint="#0A84FF"
                android:scaleType="centerInside"
                android:layout_marginEnd="8dp"
                android:contentDescription="Refresh"/>

            <ImageButton
                android:id="@+id/btnRotate"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_icon_btn"
                android:src="@drawable/ic_compose"
                android:tint="#0A84FF"
                android:scaleType="centerInside"
                android:contentDescription="New Address"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quetta Temp Mail"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="-0.03"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:id="@+id/lastSyncedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8E8E93"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- Address Capsule -->
        <LinearLayout
            android:id="@+id/capsuleLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_address_capsule"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingEnd="8dp"
            android:layout_marginBottom="10dp">
            <TextView
                android:id="@+id/tvEmailAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Initializing..."
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:ellipsize="middle"/>
            <Button
                android:id="@+id/btnCopyAddress"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_ios_blue_btn"
                android:text="Copy"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- Segmented Control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_segmented_bg"
            android:padding="2dp">
            <TextView
                android:id="@+id/segAll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Inbox"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_segment_active"/>
            <TextView
                android:id="@+id/segStarred"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Starred"
                android:textColor="#8E8E93"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@android:color/transparent"/>
            <TextView
                android:id="@+id/segOtp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="OTP Codes"
                android:textColor="#8E8E93"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@android:color/transparent"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Content Area (Tabs) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerLayout"
        android:layout_above="@id/bottomTabBar">

        <!-- TAB 1: INBOX -->
        <LinearLayout
            android:id="@+id/tabInboxContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <TextView
                    android:id="@+id/tvSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inbox"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <TextView
                    android:id="@+id/tvMsgCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 messages"
                    android:textColor="#8E8E93"
                    android:textSize="13sp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewMessages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="20dp"/>

            <LinearLayout
                android:id="@+id/layoutEmptyInbox"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📭"
                    android:textSize="48sp"
                    android:layout_marginBottom="10dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Messages Yet"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:text="Incoming emails and verification codes will appear here automatically."
                    android:textColor="#8E8E93"
                    android:textSize="13sp"
                    android:gravity="center"/>
            </LinearLayout>
        </LinearLayout>

        <!-- TAB 2: GENERATE -->
        <LinearLayout
            android:id="@+id/tabGenerateContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disposable Identity"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_ios_card"
                android:padding="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active Temp Email"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"/>
                        <TextView
                            android:id="@+id/tvGenEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#38BDF8"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_ios_blue_btn"
                        android:text="Copy"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:onClick="onGenCopyClick"
                        android:stateListAnimator="@null"/>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#3A3A3C"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:onClick="onGenRotateClick">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Generate New Address"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Deletes current address and creates a fresh inbox"
                            android:textColor="#8E8E93"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨"
                        android:textSize="18sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- TAB 3: HISTORY -->
        <LinearLayout
            android:id="@+id/tabHistoryContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Session Activity"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewHistory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_ios_card"
                android:clipToPadding="false"/>
        </LinearLayout>

        <!-- TAB 4: SETTINGS -->
        <LinearLayout
            android:id="@+id/tabSettingsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings &amp; Background"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_ios_card"
                android:padding="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:onClick="onKeepAliveClick">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Unrestricted Background Polling"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Exempt app from battery optimizations for instant OTPs"
                            android:textColor="#8E8E93"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔋"
                        android:textSize="18sp"/>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#3A3A3C"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:onClick="onExitAppClick">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Destroy Inbox &amp; Exit"
                            android:textColor="#FF453A"
                            android:textSize="15sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Deletes active address from server and stops service"
                            android:textColor="#8E8E93"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✖"
                        android:textColor="#FF453A"
                        android:textSize="16sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

    <!-- iOS Frosted Bottom Tab Bar -->
    <LinearLayout
        android:id="@+id/bottomTabBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#16161A"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/tabNavInbox"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:onClick="onTabInboxClick">
            <ImageView
                android:id="@+id/iconTabInbox"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tab_inbox"
                android:tint="#0A84FF"
                android:layout_marginBottom="2dp"/>
            <TextView
                android:id="@+id/textTabInbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inbox"
                android:textColor="#0A84FF"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabNavGenerate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:onClick="onTabGenerateClick">
            <ImageView
                android:id="@+id/iconTabGenerate"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tab_generate"
                android:tint="#8E8E93"
                android:layout_marginBottom="2dp"/>
            <TextView
                android:id="@+id/textTabGenerate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Generate"
                android:textColor="#8E8E93"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabNavHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:onClick="onTabHistoryClick">
            <ImageView
                android:id="@+id/iconTabHistory"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tab_history"
                android:tint="#8E8E93"
                android:layout_marginBottom="2dp"/>
            <TextView
                android:id="@+id/textTabHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History"
                android:textColor="#8E8E93"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabNavSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:onClick="onTabSettingsClick">
            <ImageView
                android:id="@+id/iconTabSettings"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tab_settings"
                android:tint="#8E8E93"
                android:layout_marginBottom="2dp"/>
            <TextView
                android:id="@+id/textTabSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="#8E8E93"
                android:textSize="11sp"/>
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
