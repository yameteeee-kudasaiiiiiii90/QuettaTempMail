<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#1C1C1E"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false"
    app:contentPadding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Squircle Avatar -->
        <FrameLayout
            android:id="@+id/avatarFrame"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_squircle_blue"
            android:layout_marginEnd="12dp">
            <TextView
                android:id="@+id/tvAvatarText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="A"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">
                <TextView
                    android:id="@+id/tvSender"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sender"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end"/>
                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2:30 AM"
                    android:textColor="#8E8E93"
                    android:textSize="11sp"
                    android:layout_marginStart="8dp"/>
                <CheckBox
                    android:id="@+id/cbStar"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:button="@drawable/selector_star"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_marginStart="4px"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvSubject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Subject line here"
                android:textColor="#E5E5EA"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/tvPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preview body snippet..."
                android:textColor="#8E8E93"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end"/>

            <Button
                android:id="@+id/btnCopyOtpChip"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_otp_chip"
                android:text="📋 Copy OTP: 8432"
                android:textColor="#4ADE80"
                android:textSize="11sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                android:stateListAnimator="@null"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
