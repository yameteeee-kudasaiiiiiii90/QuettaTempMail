<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Reader Navbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#16161A">
        <Button
            android:id="@+id/btnReaderBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:text="‹ Inbox"
            android:textColor="#0A84FF"
            android:textSize="16sp"
            android:textAllCaps="false"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/btnReaderDelete"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_ios_red_pill"
            android:text="Delete"
            android:textColor="#FF453A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:stateListAnimator="@null"/>
    </LinearLayout>

    <!-- Header Details Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1C1C1E"
        android:padding="16dp">
        <TextView
            android:id="@+id/tvReaderSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email Subject"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>
        <TextView
            android:id="@+id/tvReaderFrom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="From: sender@domain.com"
            android:textColor="#8E8E93"
            android:textSize="13sp"
            android:layout_marginBottom="3dp"/>
        <TextView
            android:id="@+id/tvReaderDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date: Oct 17, 2:30 AM"
            android:textColor="#8E8E93"
            android:textSize="13sp"
            android:layout_marginBottom="8dp"/>

        <!-- OTP Banner -->
        <LinearLayout
            android:id="@+id/layoutReaderOtp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_otp_banner"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_marginTop="4dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VERIFICATION CODE"
                    android:textColor="#D8B4FE"
                    android:textSize="10sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvReaderOtpValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8432"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>
            </LinearLayout>
            <Button
                android:id="@+id/btnReaderCopyOtp"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_ios_blue_btn"
                android:text="Copy OTP"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Body text / WebView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <TextView
            android:id="@+id/tvReaderBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Email body content..."
            android:textColor="#F2F2F7"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.3"/>
    </ScrollView>

</LinearLayout>
